{
  "name": "kaicalls-muse-memory-export",
  "version": "0.1.0",
  "private": true,
  "description": "The reviewed Muse caller-memory contribution and synthetic Answered-Call Bench.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run --maxWorkers 1 --minWorkers 1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild scripts/evals/run-golden-memory-recall.ts --bundle --platform=node --format=cjs --outfile=dist/golden-memory-recall.cjs",
    "bench": "tsx scripts/evals/run-golden-memory-recall.ts"
  },
  "dependencies": {
    "zod": "3.25.76",
    "dotenv": "17.1.0"
  },
  "devDependencies": {
    "@types/node": "20.19.2",
    "typescript": "5.9.3",
    "vitest": "1.6.1",
    "tsx": "4.21.0",
    "esbuild": "0.27.7"
  }
}
